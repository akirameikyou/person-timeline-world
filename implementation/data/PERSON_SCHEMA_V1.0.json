{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "person-timeline-index/person-v1.0.schema.json",
  "title": "Person Timeline Index Person Schema v1.0",
  "description": "Canonical person record schema for Person Timeline Index. Criteria v1.0 RC / Phase 1 Schema Freeze.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "personId",
    "entityType",
    "name",
    "dates",
    "historicity",
    "classification",
    "geography",
    "anchorTypes",
    "externalIds",
    "sources",
    "admissionStatus",
    "dataQualityStatus",
    "auditStatus"
  ],
  "properties": {
    "personId": {
      "type": "string",
      "pattern": "^p\\d{6,}$",
      "description": "Immutable internal ID. Never derived from name and never recycled."
    },
    "slug": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable secondary handle; not an identity key."
    },
    "entityType": {
      "type": "string",
      "enum": [
        "historical",
        "fictional",
        "mythic",
        "legendary"
      ]
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": "string"
        },
        "native": {
          "type": [
            "string",
            "null"
          ]
        },
        "readingJa": {
          "type": [
            "string",
            "null"
          ]
        },
        "preferredReadingJa": {
          "type": [
            "string",
            "null"
          ]
        },
        "romanized": {
          "type": [
            "string",
            "null"
          ]
        },
        "sortLatin": {
          "type": [
            "string",
            "null"
          ]
        },
        "nameOrder": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "family-first",
            "given-first",
            "mononym",
            "regnal",
            null
          ]
        },
        "romanizationSystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "type"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "lang": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "birthName",
                  "altName",
                  "altTransliteration",
                  "latinized",
                  "title",
                  "regnal",
                  "religiousName",
                  "exonym",
                  "other"
                ]
              }
            }
          }
        }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datingBasis",
        "birth",
        "death"
      ],
      "properties": {
        "datingBasis": {
          "type": "string",
          "enum": [
            "life",
            "reign",
            "floruit",
            "activity",
            "other"
          ]
        },
        "birth": {
          "$ref": "#/$defs/datePoint"
        },
        "death": {
          "$ref": "#/$defs/datePoint"
        },
        "floruit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/dateRange"
            }
          ]
        },
        "activityRange": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/dateRange"
            }
          ]
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "birth"
              ],
              "not": {
                "properties": {
                  "birth": {
                    "const": null
                  }
                }
              }
            },
            {
              "required": [
                "death"
              ],
              "not": {
                "properties": {
                  "death": {
                    "const": null
                  }
                }
              }
            },
            {
              "required": [
                "floruit"
              ],
              "not": {
                "properties": {
                  "floruit": {
                    "const": null
                  }
                }
              }
            },
            {
              "required": [
                "activityRange"
              ],
              "not": {
                "properties": {
                  "activityRange": {
                    "const": null
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "historicity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "historical",
            "disputed",
            "semi-legendary",
            "legendary"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryLabel",
        "roles",
        "domains",
        "fields"
      ],
      "properties": {
        "primaryLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observationValues": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "state_formation",
          "governance",
          "law",
          "diplomacy",
          "military_transformation",
          "trade_logistics",
          "knowledge_transmission",
          "science_technology",
          "philosophy",
          "literature",
          "visual_material_culture",
          "religion",
          "social_reproduction",
          "education",
          "mediation_translation",
          "ecological_knowledge",
          "health_body_knowledge",
          "popular_religion",
          "resistance",
          "sovereignty",
          "media_public_sphere",
          "navigation",
          "migration_diaspora",
          "interface_between_societies"
        ]
      },
      "uniqueItems": true
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionPrimary",
        "regionsAssociated",
        "countryModern",
        "historicalPolity"
      ],
      "properties": {
        "regionPrimary": {
          "type": [
            "string",
            "null"
          ]
        },
        "regionsAssociated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "countryModern": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "historicalPolity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "birthPlace": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "lat": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -180,
                  "maximum": 180
                },
                "certainty": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "documented",
                    "approximate",
                    "disputed",
                    "unknown",
                    null
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "anchorTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "global",
          "regional",
          "domain",
          "network",
          "tradition_knowledge"
        ]
      },
      "uniqueItems": true
    },
    "networkTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "externalIds": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "properties": {
        "wikidata": {
          "type": [
            "string",
            "null"
          ]
        },
        "viaf": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "default": {}
    },
    "relatedOS": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "fields",
          "status"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
              "checked",
              "verified"
            ]
          },
          "evidenceForms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "written_record",
                "authored_text",
                "epigraphy",
                "archaeology",
                "material_culture",
                "oral_history",
                "genealogical_tradition",
                "indigenous_tradition",
                "contemporary_external_record",
                "later_historical_record"
              ]
            },
            "uniqueItems": true
          },
          "lineageId": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencyType": {
            "type": "string",
            "enum": [
              "independent",
              "derivative",
              "shared_tradition",
              "unknown"
            ]
          },
          "sourcePosition": {
            "type": "string",
            "enum": [
              "interested",
              "adversarial",
              "descriptive",
              "unknown"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "admissionStatus": {
      "type": "string",
      "enum": [
        "DEFAULT",
        "EXPANDED",
        "DISPUTED",
        "HOLD_EVIDENCE"
      ]
    },
    "dataQualityStatus": {
      "type": "string",
      "enum": [
        "CLEAN",
        "VERIFY",
        "FIX_REQUIRED"
      ]
    },
    "auditStatus": {
      "type": "string",
      "enum": [
        "candidate",
        "provisional",
        "verified",
        "published",
        "retired"
      ]
    }
  },
  "$defs": {
    "datePoint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "year",
            "precision",
            "certainty"
          ],
          "properties": {
            "year": {
              "type": [
                "integer",
                "null"
              ]
            },
            "precision": {
              "type": "string",
              "enum": [
                "day",
                "month",
                "year",
                "decade",
                "century",
                "circa",
                "unknown"
              ]
            },
            "certainty": {
              "type": "string",
              "enum": [
                "documented",
                "approximate",
                "disputed",
                "unknown"
              ]
            },
            "calendarSource": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startYear",
        "endYear",
        "precision",
        "certainty"
      ],
      "properties": {
        "startYear": {
          "type": [
            "integer",
            "null"
          ]
        },
        "endYear": {
          "type": [
            "integer",
            "null"
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "year",
            "decade",
            "century",
            "circa",
            "unknown"
          ]
        },
        "certainty": {
          "type": "string",
          "enum": [
            "documented",
            "approximate",
            "disputed",
            "unknown"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
